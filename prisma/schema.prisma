generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model InvoiceRecord {
  id              String   @id @default(cuid())
  customer        String
  description     String
  quotationNumber String
  noPo            String
  dateDelivery    DateTime
  noDo            String
  noInv           String
  amountIdr       Float
  qty             Int      @default(1)
  remark          String
  createdAt       DateTime @default(now())
}

model Invoice {
  id              String   @id @default(cuid())
  customer        String
  attn            String
  cc              String   @default("-")
  term            String
  validity        String
  leadTime        String
  fromUser        String
  handphone       String
  quotationNumber String
  dateDelivery    DateTime
  noInv           String
  description     String
  qty             Int      @default(1)
  amountIdr       Float
  remark          String   @default("Prices are valid 1 month after offer is sent")
  address         String
  createdAt       DateTime @default(now())
  processes       String   @default("-")
  material        String   @default("-")
  discount        Float    @default(0)
  unit            String   @default("pcs")
  materials       String[] @default([])
}

model Item {
  id          String   @id @default(uuid())
  name        String
  type        ItemType
  s3Key       String?
  url         String?
  size        Int?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentData Json?
  parent      Item?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Item[]   @relation("FolderHierarchy")

  @@index([parentId])
}

model ChartOfAccount {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  type         AccountType
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  journalLines JournalLine[]
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime
  reference   String?
  description String
  status      EntryStatus   @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  job         String?
  qty         Int?          @default(0)
  uom         String?
  lines       JournalLine[]
}

model JournalLine {
  id             String         @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal        @default(0.00) @db.Decimal(15, 2)
  credit         Decimal        @default(0.00) @db.Decimal(15, 2)
  createdAt      DateTime       @default(now())
  invoiceNo      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model PoTask {
  id                String       @id @default(uuid())
  poNumber          String       @unique
  description       String?
  currentStage      TaskStage    @default(DRAWING)
  isCompleted       Boolean      @default(false)
  estimatedDelivery DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  doNumber          String?
  items             PoTaskItem[]
}

model PoTaskItem {
  id          String    @id @default(uuid())
  poTaskId    String
  stage       TaskStage
  name        String
  quantity    Float?
  unit        String?
  isCompleted Boolean   @default(false)
  sortOrder   Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  poTask      PoTask    @relation(fields: [poTaskId], references: [id], onDelete: Cascade)

  @@index([poTaskId, stage])
}

model Job {
  id             String   @id @default(cuid())
  jobName        String
  qty            Decimal  @db.Decimal(10, 2)
  uom            String
  customer       String
  date           DateTime
  poNumber       String
  leadTime       Int?
  materialStatus String?
  status         String   @default("Pending")
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  doNumber       String?

  @@index([customer])
  @@index([poNumber])
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
}

enum ItemType {
  FOLDER
  FILE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryStatus {
  DRAFT
  POSTED
  VOIDED
}

enum TaskStage {
  DRAWING
  MATERIAL
  TOOLING
  PRODUCTION
  SUBCON
  FINISHED
}

enum EcomCategory {
  MATERIALS
  TOOLING
  STANDARD_PART
}

model Ecom {
  id          String        @id @default(cuid())
  name        String
  price       Float
  size        String
  diameter    Float?
  quantity    Int           @default(1)
  imageUrl    String?
  category    EcomCategory?
  subCategory String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
  @@index([category])
}

model Customer {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(3)
  name        String
  address     String
  createdAt   DateTime @default(now())
}
